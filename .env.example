# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Every value here is optional: the site runs without any of them.

# Public address of the site (sitemap, canonical links, share images).
NEXT_PUBLIC_SITE_URL=https://gxuri.is-a.dev

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (public by design).
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID, for heatmaps and session recordings (public by design).
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console "HTML tag" verification code: only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GitHub token used on the server only, to avoid GitHub's anonymous rate limit
# when fetching the contribution graph and repos. A fine-grained token with
# "Public repositories (read-only)" access and no other permissions is enough.
# SECRET: never commit a real value, never prefix it with NEXT_PUBLIC_.
GITHUB_TOKEN=
